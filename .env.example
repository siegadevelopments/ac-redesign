# Kit (formerly ConvertKit) — powers both form integrations. Same account,
# two separate forms so Kit's own automation can notify differently.
KIT_API_KEY=

# Newsletter / lead magnet (src/components/sections/Newsletter.tsx via
# src/app/api/subscribe). Create a form in the Kit dashboard with the
# Business Systems Audit Checklist configured as its incentive email, then
# set:
KIT_FORM_ID=

# Free Business Automation Assessment (src/app/discovery-call via
# src/app/api/assessment). Create a second, separate form, then create these
# six custom fields on the Kit account with exactly these keys before
# setting this — the API rejects unknown field keys:
#   business, website, industry, team_size, biggest_challenge, current_tools,
#   automate_wish
KIT_ASSESSMENT_FORM_ID=

# Homepage problem box (src/app/api/problem). Every send first emails the
# founder through Resend (https://resend.com) — that email is what makes a
# send count as successful, so all three Resend values are required. Create
# a Resend account, verify the sending domain, then set:
#   RESEND_API_KEY      — a Resend API key with sending access
#   PROBLEM_NOTIFY_TO   — the inbox that receives each problem send
#   PROBLEM_NOTIFY_FROM — a sender on the verified domain, e.g.
#                         Apprising Creatives <hello@yourdomain>
RESEND_API_KEY=
PROBLEM_NOTIFY_TO=
PROBLEM_NOTIFY_FROM=

# The contact is then recorded in Kit (uses KIT_API_KEY above). Create a
# third, separate form, then create these two custom fields on the Kit
# account with exactly these keys before setting this — the API rejects
# unknown field keys:
#   problem, problem_headache
KIT_PROBLEM_FORM_ID=
