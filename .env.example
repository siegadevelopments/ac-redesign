# Kit (formerly ConvertKit) — powers both form integrations. Same account,
# two separate forms so Kit's own automation can notify differently.
KIT_API_KEY=

# Newsletter / lead magnet (src/components/sections/Newsletter.tsx via
# src/app/api/subscribe). Create a form in the Kit dashboard with the
# Business Systems Audit Checklist configured as its incentive email, then
# set:
KIT_FORM_ID=

# Free Business Automation Assessment (src/app/discovery-call via
# src/app/api/assessment). Create a second, separate form, then create these
# six custom fields on the Kit account with exactly these keys before
# setting this — the API rejects unknown field keys:
#   business, website, industry, team_size, biggest_challenge, current_tools,
#   automate_wish
KIT_ASSESSMENT_FORM_ID=
